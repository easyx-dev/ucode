# 生产环境变量模板：复制为 `.env.prod`（生产，NODE_ENV=production）后按需修改。
# 全局 `ucode` 与 `pnpm start` 读取 `.env.prod`；开发（pnpm dev / 测试）读 `.env`。
# 两者都从 cwd 向上查找，`.env.prod` / `.env` 均为本地文件（见 .gitignore）。
# 模型 / 端点 / API Key 不放这里，而是写 $APP_HOME/app/config.json。
# 以下项都必须在环境变量里声明，缺失 / 非法即启动报错——代码不带默认值。

# 工作 / 配置主目录；`~` 展开为用户主目录，相对路径按环境文件所在目录解析
APP_HOME=~/.ucode

# 监听地址与端口（0 表示自选可用端口，启动后回写 service.json）
APP_HOST=127.0.0.1
APP_PORT=19688

# 内存中的 AgentSession 空闲多久后被回收（毫秒）
APP_POOL_IDLE_MS=600000

# 日志级别（trace / debug / info / warn / error / fatal / silent）
APP_LOG_LEVEL=info

# 系统提示词源：custom（自研）/ pi（pi 默认 + 自研片段）；改后需重启
APP_PROMPT_SOURCE=custom
