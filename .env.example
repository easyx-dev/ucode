# 基础设施配置。模型 / 端点 / API Key 不在这里配置，
# 而是通过 /api/v1/config/update 接口写入 $APP_HOME/app/config.json（见 README）。

# HTTP 服务端口
APP_PORT=2048

# 配置 / 数据主目录：harness/（auth.json / sessions/）、app/（config.json / app.db）
# 与 workspace/（未绑定目录的会话的工作目录）三个数据子目录。
# 不设置时默认 ~/.ucode；显式指定请用绝对路径，相对路径会按仓库根解析。
# APP_HOME=/absolute/path

# 内存中的 AgentSession 空闲多久后被回收（毫秒）
APP_POOL_IDLE_MS=600000

# 允许的跨域来源（逗号分隔），带 Cookie 时不能用 `*`。
# 桌面端渲染层跑在 http://localhost:5174，需显式放行它才能调本机服务：
# APP_CORS_ORIGIN=http://localhost:5174

# pino 日志级别（trace / debug / info / warn / error / fatal）；不设置时开发用 debug、生产用 info
# APP_LOG_LEVEL=debug

# 系统提示词源：custom（自研，默认）/ pi（pi 默认 + 自研片段，供评测对照）；改后需重启
# APP_PROMPT_SOURCE=custom
