# 基础设施配置。模型 / 端点 / API Key 不在这里配置，
# 而是通过 /api/v1/config/update 接口写入 .tmp/.ucode/config.json（见 README）。

# HTTP 服务端口
PORT=2048

# pi agent 的工作目录（读写文件、会话分组都用它）
PI_WORKSPACE_DIR=.tmp/.ucode

# pi agent 目录：auth.json / models.json / sessions/ 都放这里
PI_AGENT_DIR=.tmp/.ucode/agent

# 应用配置目录（config.json）
PI_DATA_DIR=.tmp/.ucode

# 内存中的 AgentSession 空闲多久后被回收（毫秒）
POOL_IDLE_MS=600000

# 开发模式跨域来源
CORS_ORIGIN=*
