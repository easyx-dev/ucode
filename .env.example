# 基础设施配置。模型 / 端点 / API Key 不在这里配置，
# 而是通过 /api/v1/config/update 接口写入 $APP_HOME/app/config.json（见 README）。

# HTTP 服务端口
APP_PORT=2048

# 工作 / 配置主目录：agent 工作目录，以及 pi/（auth.json / models.json / sessions/）
# 与 app/（config.json / ucode.db）两个数据子目录
APP_HOME=.tmp/.ucode

# 内存中的 AgentSession 空闲多久后被回收（毫秒）
APP_POOL_IDLE_MS=600000

# 开发模式跨域来源
APP_CORS_ORIGIN=*

# pino 日志级别（trace / debug / info / warn / error / fatal）；不设置时开发用 debug、生产用 info
# APP_LOG_LEVEL=debug
