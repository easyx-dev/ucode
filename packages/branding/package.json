{
  "name": "@ucode/branding",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "品牌配置与资源（叶子包，无内部依赖；构建期注入的单一事实来源）",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "dev-src": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./src/node.ts",
      "dev-src": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./brand.json": "./brand.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  }
}
