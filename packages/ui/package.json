{
  "name": "@ucode/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./base/*": "./src/base/*.tsx",
    "./business/*": "./src/business/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./provider": "./src/provider/index.tsx",
    "./presets/workspace": "./src/presets/workspace-layout.tsx",
    "./theme.css": "./src/styles/theme.css"
  },
  "types": "./src/index.ts",
  "scripts": {
    "test": "node --import tsx --test \"src/**/__tests__/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shikijs/langs": "^4.5.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-hard-break": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@ucode/brand": "workspace:*",
    "@ucode/contracts": "workspace:*",
    "@ucode/i18n": "workspace:*",
    "@ucode/sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dayjs": "^1.11.23",
    "diff": "^9.0.0",
    "i18next": "^26.4.2",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
