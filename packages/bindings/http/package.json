{
  "name": "@ucode/binding-http",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "绑定层 HTTP + SSE：下行推送 / 上行 POST，按标识配对",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "dev-src": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "dev-src": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@ucode/protocol": "workspace:*",
    "hono": "catalog:"
  }
}
