{
  "name": "@ucode/binding-stdio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "绑定层 stdio：行分隔 JSON，按字节切分",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "dev-src": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "dev-src": "./src/client.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ucode/protocol": "workspace:*"
  }
}
