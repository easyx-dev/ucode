{
  "name": "ucode",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm -F @ucode/server dev\" \"pnpm -F @ucode/web dev\"",
    "build": "pnpm -F @ucode/web build",
    "start": "pnpm -F @ucode/server start",
    "typecheck": "pnpm -r typecheck",
    "check": "biome check . && pnpm -r typecheck && node scripts/verify/index.ts",
    "verify": "node scripts/verify/index.ts",
    "format": "biome format --write .",
    "smoke": "pnpm -F @ucode/server smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "concurrently": "^10.0.5"
  }
}
