{
  "name": "ucode",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm -F @ucode/server dev\" \"pnpm -F @ucode/web dev\"",
    "dev:desktop": "pnpm -F @ucode/desktop dev",
    "build:web": "pnpm -F @ucode/web build",
    "build:server": "node scripts/build-cli.mjs",
    "build": "pnpm build:web && pnpm build:server",
    "start": "NODE_ENV=production node dist/ucode.js",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "biome check . && pnpm -r typecheck && pnpm -r test && tsx scripts/verify/index.ts",
    "verify": "tsx scripts/verify/index.ts",
    "brand:replace": "node packages/brand/scripts/replace.ts",
    "format": "biome format --write .",
    "smoke": "pnpm -F @ucode/server smoke",
    "eval": "pnpm -F @ucode/server eval",
    "api:docs": "tsx scripts/api-docs/generate.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "fuzzysort": "^4.0.2",
    "hono": "^4.13.10",
    "pino": "^10.3.1",
    "turndown": "^7.2.4",
    "typebox": "^1.3.27",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
