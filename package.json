{
  "name": "ucode",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "APP_HOME=.tmp/.ucode concurrently -n server,web -c cyan,magenta \"pnpm -F @ucode/server dev\" \"pnpm -F @ucode/web dev\"",
    "dev:desktop": "pnpm -F @ucode/desktop dev",
    "dev:hub": "pnpm --dir hub run dev",
    "build:web": "pnpm -F @ucode/web build",
    "build:server": "node scripts/build-cli.mjs",
    "build:hub": "pnpm --dir hub run build",
    "build": "pnpm build:web && pnpm build:server",
    "postinstall": "node scripts/postinstall.mjs",
    "start": "node dist/ucode.js",
    "start:desktop": "NODE_ENV=production pnpm -F @ucode/desktop start",
    "start:hub": "pnpm --dir hub run start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "biome check . && pnpm -r typecheck && pnpm -r test && tsx scripts/verify/index.ts",
    "check:fast": "tsx scripts/check-fast.ts",
    "verify": "tsx scripts/verify/index.ts",
    "brand:replace": "node packages/brand/scripts/replace.ts",
    "format": "biome format --write .",
    "smoke": "pnpm -F @ucode/server smoke",
    "eval": "pnpm -F @ucode/server eval",
    "api:docs": "tsx scripts/api-docs/generate.ts",
    "plugin:docs": "tsx scripts/plugin-docs/generate.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/node-ws": "catalog:",
    "@hono/zod-validator": "catalog:",
    "execa": "catalog:",
    "fflate": "catalog:",
    "fuzzysort": "catalog:",
    "hono": "catalog:",
    "node-pty": "catalog:",
    "pino": "catalog:",
    "playwright-core": "catalog:",
    "tar": "catalog:",
    "turndown": "catalog:",
    "typebox": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "concurrently": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
