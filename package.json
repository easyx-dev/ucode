{
  "name": "ucode",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm -F @ucode/server dev\" \"pnpm -F @ucode/web dev\"",
    "dev:desktop": "pnpm -F @ucode/desktop dev",
    "build": "pnpm -F @ucode/web build",
    "start": "pnpm -F @ucode/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "biome check . && pnpm -r typecheck && pnpm -r test && tsx scripts/verify/index.ts",
    "verify": "tsx scripts/verify/index.ts",
    "brand:replace": "node packages/brand/scripts/replace.ts",
    "format": "biome format --write .",
    "smoke": "pnpm -F @ucode/server smoke",
    "eval": "pnpm -F @ucode/server eval",
    "api:docs": "tsx scripts/api-docs/generate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
