{
  "name": "ucode",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:boundaries": "node tools/check-boundaries.ts",
    "check:brand": "node tools/check-brand-literals.ts",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm check:boundaries && pnpm check:brand && pnpm test",
    "ucode": "node --conditions=dev-src apps/cli/src/main.ts",
    "build:libs": "pnpm -r run build"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@ucode/binding-http": "workspace:*",
    "@ucode/binding-rpc": "workspace:*",
    "@ucode/binding-stdio": "workspace:*",
    "@ucode/binding-ws": "workspace:*",
    "@ucode/branding": "workspace:*",
    "@ucode/cli": "workspace:*",
    "@ucode/core": "workspace:*",
    "@ucode/data-layer-spec": "workspace:*",
    "@ucode/protocol": "workspace:*",
    "@ucode/sdk": "workspace:*",
    "@ucode/store": "workspace:*",
    "oxc-parser": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
