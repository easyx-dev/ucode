{
  "name": "@easyx/ucode",
  "version": "0.6.1",
  "description": "UCode —— 带对话界面与本机工具集的开发助手：服务与 Web UI 整包安装，一条命令后台常驻",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "ucode"
  ],
  "homepage": "https://github.com/easyx-dev/ucode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easyx-dev/ucode.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "resourceRoot": true,
  "bin": {
    "ucode": "dist/ucode.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/ucode.js",
    "apps/web/dist",
    "defaults",
    "scripts/postinstall.mjs",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "api:docs": "tsx scripts/api-docs/generate.ts",
    "brand:replace": "node packages/brand/scripts/replace.ts",
    "build": "pnpm plugins:build && pnpm build:web && pnpm build:server",
    "build:hub": "pnpm --dir hub run build",
    "build:server": "node scripts/build-cli.mjs",
    "build:web": "pnpm -F @ucode/web build",
    "check": "biome check . && pnpm -r typecheck && pnpm -r test && tsx scripts/verify/index.ts",
    "check:fast": "tsx scripts/check-fast.ts",
    "dev": "APP_HOME=.tmp/.ucode concurrently -n server,web -c cyan,magenta \"pnpm -F @ucode/server dev\" \"pnpm -F @ucode/web dev\"",
    "dev:desktop": "pnpm -F @ucode/desktop dev",
    "dev:hub": "pnpm --dir hub run dev",
    "eval": "pnpm -F @ucode/server eval",
    "format": "biome format --write .",
    "pack:check": "node scripts/pack-npm.mjs",
    "plugin:docs": "tsx scripts/plugin-docs/generate.ts",
    "plugins:build": "node scripts/build-plugins.mjs",
    "plugins:dev": "pnpm --dir plugins run build --watch",
    "postinstall": "node scripts/postinstall.mjs",
    "restart": "node dist/ucode.js service restart",
    "smoke": "pnpm -F @ucode/server smoke",
    "start": "node dist/ucode.js",
    "start:desktop": "NODE_ENV=production pnpm -F @ucode/desktop start",
    "start:hub": "pnpm --dir hub run start",
    "status": "node dist/ucode.js service status",
    "stop": "node dist/ucode.js service stop",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "tsx scripts/verify/index.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/node-ws": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@open-pencil/core": "catalog:",
    "@open-pencil/scene-graph": "catalog:",
    "execa": "catalog:",
    "fflate": "catalog:",
    "fuzzysort": "catalog:",
    "hono": "catalog:",
    "node-pty": "catalog:",
    "pino": "catalog:",
    "playwright-core": "catalog:",
    "tar": "catalog:",
    "turndown": "catalog:",
    "typebox": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "concurrently": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
