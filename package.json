{
  "name": "ucode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm -F @ucode/server dev\" \"pnpm -F @ucode/web dev\"",
    "build": "pnpm -F @ucode/web build",
    "start": "pnpm -F @ucode/server start",
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm -F @ucode/server smoke"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
