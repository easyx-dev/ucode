{
  "name": "@ucode/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "\u542f\u52a8\u5165\u53e3\uff1a\u5185\u7f6e Web \u4e0e TUI \u58f3\uff0c\u5e76\u53ef\u542f\u52a8\u6838\u5fc3\u5c42",
  "bin": {
    "ucode": "./src/main.ts"
  },
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "dev-src": "./src/main.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ucode/branding": "workspace:*",
    "@ucode/protocol": "workspace:*",
    "@ucode/sdk": "workspace:*",
    "@ucode/service": "workspace:*",
    "@ucode/tui": "workspace:*",
    "@ucode/web": "workspace:*"
  }
}
