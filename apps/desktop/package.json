{
  "name": "@ucode/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/build-main.mjs && concurrently -k -n renderer,electron -c cyan,magenta \"vite\" \"electron . --dev\"",
    "start": "pnpm build && electron .",
    "build:main": "node scripts/build-main.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "test": "node --import tsx --test \"src/**/__tests__/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "browser:smoke": "node scripts/browser-panel-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "catalog:",
    "@ucode/brand": "workspace:*",
    "@ucode/contracts": "workspace:*",
    "@ucode/i18n": "workspace:*",
    "@ucode/sdk": "workspace:*",
    "@ucode/ui": "workspace:*",
    "i18next": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "catalog:",
    "electron": "^44.5.1",
    "esbuild": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
