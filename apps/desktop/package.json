{
  "name": "@ucode/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "\u684c\u9762\u58f3\uff08Electron \u4e3b\u8fdb\u7a0b + \u4e0e Web \u540c\u6e90\u7684\u754c\u9762\uff1b\u786e\u4fdd\u5171\u4eab\u670d\u52a1\u5728\u8dd1\uff0c\u4e0d import \u670d\u52a1\u5c42\uff09",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "bundle-core": "node ./scripts/bundle-core.mjs",
    "dist": "pnpm bundle-core && electron-builder --dir"
  },
  "main": "main.mjs",
  "devDependencies": {
    "electron": "catalog:",
    "esbuild": "catalog:",
    "electron-builder": "^26.17.0"
  },
  "dependencies": {
    "@ucode/branding": "workspace:*"
  }
}
