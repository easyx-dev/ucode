{
  "name": "@ucode/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "桌面壳（Electron 主进程 + 复用 UI 的渲染进程；主进程 spawn 核心层，不 import 核心层）",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "build": "vite build",
    "bundle-core": "node ./scripts/bundle-core.mjs",
    "dist": "pnpm build && pnpm bundle-core && electron-builder --dir"
  },
  "dependencies": {
    "@ucode/sdk": "workspace:*",
    "@ucode/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "main": "main.mjs",
  "devDependencies": {
    "electron": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vite": "catalog:",
    "@vitejs/plugin-react": "^5.1.0",
    "@tailwindcss/vite": "catalog:",
    "esbuild": "catalog:",
    "electron-builder": "^26.17.0"
  }
}
