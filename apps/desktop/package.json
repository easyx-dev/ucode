{
  "name": "@ucode/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/build-main.mjs && concurrently -k -n renderer,electron -c cyan,magenta \"vite\" \"electron . --dev\"",
    "start": "pnpm build && electron .",
    "build:main": "node scripts/build-main.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "test": "node --import tsx --test \"src/**/__tests__/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@ucode/brand": "workspace:*",
    "@ucode/i18n": "workspace:*",
    "@ucode/sdk": "workspace:*",
    "@ucode/ui": "workspace:*",
    "i18next": "^26.4.2",
    "lucide-react": "^0.545.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
