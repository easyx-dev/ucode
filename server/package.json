    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx scripts/eval.ts",
    "typecheck": "tsc --noEmit",
    "browser:smoke": "tsx scripts/browser-smoke.ts",
    "browser:parity": "tsx scripts/browser-parity.ts",
    "browser:desktop-smoke": "tsx scripts/browser-desktop-smoke.ts"
  },
