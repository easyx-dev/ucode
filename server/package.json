    "@open-pencil/core": "catalog:",
    "@open-pencil/scene-graph": "catalog:",
    "@ucode/brand": "workspace:*",
    "@ucode/contracts": "workspace:*",
    "@ucode/hub-protocol": "workspace:*",
    "execa": "catalog:",
    "fflate": "catalog:",
    "fuzzysort": "catalog:",
    "hono": "catalog:",
    "node-pty": "catalog:",
    "pino": "catalog:",
    "playwright-core": "catalog:",
    "tar": "catalog:",
